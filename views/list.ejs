<!DOCTYPE html>
<html lang="en">
<head>
    <title>Todo list</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <div class="box">
        <h1>Todo List</h1>
    </div>
    <div class="box">

        <% ejes.forEach(function(items){ %>
            <form action="/delete" method="POST">
                <div class="item">
                    <input type="checkbox" class="task-checkbox" name="checkbox1" value="<%= items._id %>" onchange="this.form.submit()">
                    <p class="task-text"><%= items.name %></p>
                </div>  
            </form>
        <% }) %>
        <form action="/" method="POST">
            <input type="text" name="ele1" placeholder="Enter a new task" >
            <button type="submit">+</button>
        </form>
    </div>
</body>
</html>